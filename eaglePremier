-- Safe Anti-Ban Execution Logic
RunService.Heartbeat:Connect(function()
    if not spamActive or not parryRemote then return end
    
    local currentTime = tick()
    -- This sets a randomized humanized delay between 0.07 and 0.095 seconds (roughly 11-14 CPS)
    local randomDelay = math.random(70, 95) / 1000
    
    if currentTime - lastParryTime >= randomDelay then
        lastParryTime = currentTime
        local args = buildParryArgs()
        if args then 
            parryRemote:FireServer(unpack(args)) 
        end
    end
end)
